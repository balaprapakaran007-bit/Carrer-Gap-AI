# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin Credentials (Optional for production Firestore)
FIREBASE_PROJECT_ID=careergap-ai
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# CORS & Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
JOB_URL_FETCH_ALLOWLIST=linkedin.com,indeed.com,glassdoor.com,lever.co,greenhouse.io,workday.com,builtin.com,wellfound.com,github.com
ENABLE_EMAIL_REMINDERS=false
